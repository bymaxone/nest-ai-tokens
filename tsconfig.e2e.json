{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "noUnusedParameters": false,
    "baseUrl": ".",
    "types": ["node", "jest", "reflect-metadata"],
    "paths": {
      "@bymax-one/nest-ai-tokens": ["./src/server/index.ts"],
      "@bymax-one/nest-ai-tokens/shared": ["./src/shared/index.ts"],
      "@bymax-one/nest-ai-tokens/prices": ["./src/prices/index.ts"],
      "@bymax-one/nest-ai-tokens/prisma": ["./src/prisma/index.ts"],
      "@bymax-one/nest-ai-tokens/redis": ["./src/redis/index.ts"]
    }
  },
  "include": ["test/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
