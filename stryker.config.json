{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "jest",
  "plugins": [
    "@stryker-mutator/jest-runner",
    "@stryker-mutator/typescript-checker"
  ],
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.stryker.config.ts",
    "enableFindRelatedTests": false
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "timeoutMS": 15000,
  "mutate": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/prices/model-prices.seed.ts",
    "src/redis/index.ts",
    "src/prisma/adapter-sql.ts",
    "src/prisma/budget-applications.ts",
    "src/prisma/budget-statements.ts",
    "src/prisma/sql.ts",
    "src/prisma/raw-client.ts",
    "!src/**/*.spec.ts",
    "!src/prices/index.ts",
    "!src/shared/index.ts",
    "!src/shared/normalizers/index.ts",
    "!src/server/index.ts",
    "!src/server/config/index.ts",
    "!src/server/enforcement/index.ts",
    "!src/server/errors/index.ts",
    "!src/server/interfaces/index.ts",
    "!src/server/services/index.ts",
    "!src/server/interfaces/*.interface.ts",
    "!src/server/config/resolved-options.ts"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "concurrency": 1,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
