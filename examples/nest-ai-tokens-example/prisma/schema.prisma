// Prisma schema for nest-ai-tokens-example
//
// This schema merges the @bymax-one/nest-ai-tokens seven-table fragment (docs §15.3)
// with the application's own models.
//
// Merge workflow (§15.3):
//   1. Copy the library's schema fragment from docs/spec §15.3 into this file.
//   2. Run: pnpm prisma migrate dev --name init
//   3. The library's `PrismaAiTokensStore` adapter queries the merged tables directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Application models ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  name      String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
}

enum UserRole {
  USER
  ADMIN
}

// ── @bymax-one/nest-ai-tokens seven-table fragment ──────────────────────────────
// Source: docs/technical_specification.md §15.1 (schema fragment)
// DO NOT modify column names — PrismaAiTokensStore uses raw SQL parameterized queries.

model AiUsageRecord {
  id                   String   @id @default(uuid())
  tenantId             String
  scopeType            String
  scopeId              String
  beneficiaryType      String?
  beneficiaryId        String?
  requestedBy          String?
  feature              String
  provider             String
  model                String
  operation            String
  serviceTier          String?
  inputTokens          BigInt   @default(0)
  outputTokens         BigInt   @default(0)
  cacheReadTokens      BigInt   @default(0)
  cacheWriteTokens     BigInt   @default(0)
  reasoningTokens      BigInt   @default(0)
  rawCostNanoUsd       BigInt   @default(0)
  billedCostNanoUsd    BigInt   @default(0)
  markupMultiplier     Decimal  @default(1) @db.Decimal(10, 4)
  status               String   @default("POSTED")
  idempotencyKey       String   @unique
  payloadHash          String?
  hashChainLink        String?
  contentSidecarRef    String?
  systemCostCategory   String?
  isSystemCost         Boolean  @default(false)
  metadata             Json?
  recordedAt           DateTime @default(now())
  postedAt             DateTime?
  reversedAt           DateTime?
  releasedAt           DateTime?
  priceSnapshotId      String?

  @@index([tenantId, scopeType, scopeId, recordedAt])
  @@index([tenantId, feature, recordedAt])
  @@index([status, recordedAt])
  @@map("ai_usage_records")
}

model AiModelPrice {
  id             String   @id @default(uuid())
  provider       String
  model          String
  serviceTier    String?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  inputPerMillion  BigInt
  outputPerMillion BigInt
  cacheReadPerMillion  BigInt @default(0)
  cacheWritePerMillion BigInt @default(0)
  reasoningPerMillion  BigInt @default(0)
  surcharges     Json?
  ratingMode     String   @default("rate-table")
  currency       String   @default("nano-USD")
  source         String?
  createdAt      DateTime @default(now())

  @@unique([provider, model, serviceTier, effectiveFrom])
  @@index([provider, model, effectiveFrom])
  @@map("ai_model_prices")
}

model AiWallet {
  id          String   @id @default(uuid())
  tenantId    String
  ownerType   String
  ownerId     String
  currency    String   @default("nano-USD")
  balance     BigInt   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     AiWalletEntry[]

  @@unique([tenantId, ownerType, ownerId, currency])
  @@map("ai_wallets")
}

model AiWalletEntry {
  id              String   @id @default(uuid())
  walletId        String
  wallet          AiWallet @relation(fields: [walletId], references: [id])
  entryType       String
  amountNanoUsd   BigInt
  balanceAfter    BigInt
  reason          String?
  idempotencyKey  String   @unique
  expiresAt       DateTime?
  priority        Int?
  usageRecordId   String?
  createdAt       DateTime @default(now())

  @@index([walletId, createdAt])
  @@map("ai_wallet_entries")
}

model AiBudget {
  id               String   @id @default(uuid())
  tenantId         String
  scopeType        String
  scopeId          String
  features         String[]
  window           String
  anchorAt         DateTime?
  limitNanoUsd     BigInt?
  limitTokens      BigInt?
  limitCount       BigInt?
  softThresholds   Decimal[] @db.Decimal(5, 4)
  policy           String   @default("block")
  resetAt          DateTime?
  spentNanoUsd     BigInt   @default(0)
  spentTokens      BigInt   @default(0)
  spentCount       BigInt   @default(0)
  reservedNanoUsd  BigInt   @default(0)
  reservedTokens   BigInt   @default(0)
  reservedCount    BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, scopeType, scopeId, features, window, anchorAt])
  @@index([tenantId, scopeType, scopeId])
  @@map("ai_budgets")
}

model AiHold {
  id               String   @id @default(uuid())
  tenantId         String
  scopeType        String
  scopeId          String
  feature          String
  estimateNanoUsd  BigInt   @default(0)
  estimateTokens   BigInt   @default(0)
  status           String   @default("PENDING")
  usageRecordId    String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, status, expiresAt])
  @@map("ai_holds")
}

model AiContentSidecar {
  ref         String   @id
  content     String
  contentType String   @default("text/plain")
  masked      Boolean  @default(false)
  ttlSeconds  Int?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("ai_content_sidecars")
}
