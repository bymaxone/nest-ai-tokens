{
  "name": "nest-ai-tokens-example",
  "version": "0.1.0",
  "description": "Reference implementation for @bymax-one/nest-ai-tokens: metering, budgets, wallets, markup, streaming, and reporting in a NestJS 11 app.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "NODE_OPTIONS='--experimental-vm-modules' ts-node -r tsconfig-paths/register src/main.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@bymax-one/nest-ai-tokens": "file:../..",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "ioredis": "^5.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.0"
  }
}
