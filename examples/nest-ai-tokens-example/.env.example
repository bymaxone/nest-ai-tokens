# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ai_example:secret@localhost:5432/ai_example_db"

# ── Redis ────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── App ──────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Markup (resale multiplier) ───────────────────────────────────────────────────
# End-users are billed 4× provider cost (i.e. a $0.01 provider call → $0.04 user-facing)
AI_MARKUP=4.0

# ── Credit exchange rate ─────────────────────────────────────────────────────────
# 1 credit = $5 USD — the rate at which granted credits convert to nano-USD
# 1 credit = 5_000_000_000 nano-USD
AI_CREDIT_RATE_NANO_USD=5000000000
